<configuration>
    <!-- Realistic SLF4J wiring, not a snippet: AgentRuntime builds its pipeline through the
         same PipelineBootstrap as every other integration, so Slf4jTraceEventListener
         auto-attaches once narrativetrace-slf4j is on the classpath (see the testRuntimeOnly
         comment in build.gradle.kts) — even for agent-woven classes. This file only decides
         where the resulting TRACE events go. documentation/configuration-guide.md §7. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%logger] - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="narrativetrace" level="TRACE" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
