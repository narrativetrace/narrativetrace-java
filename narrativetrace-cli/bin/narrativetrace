#!/usr/bin/env bash
# narrativetrace — thin launcher for the free-tier CLI (today: the `doctor` verb).
# Locates this module's built jar and runs it under the current JVM. Zero network, read-only.
set -euo pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
# Highest VERSION, not first alphabetically: build/libs accumulates every version ever built in
# this working tree, and `head -n1` picked the OLDEST of them — which is how a jar that no longer
# ran at all could answer `narrativetrace doctor` correctly for a whole session (2026-09-24).
JAR="$(ls "$DIR"/build/libs/narrativetrace-cli-*.jar 2>/dev/null | grep -Ev -- '-sources\.jar$|-javadoc\.jar$' | sort -V | tail -n1 || true)"

if [ -z "$JAR" ]; then
  echo "narrativetrace: no build/libs/narrativetrace-cli-*.jar found — run" \
       "'./gradlew :narrativetrace-cli:jar' first" >&2
  exit 2
fi

exec java -jar "$JAR" "$@"
