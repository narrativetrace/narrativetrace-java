<configuration>
    <!-- src/main/resources/logback.xml is what the pages embed and what a reader writes. This
         file is the same configuration with one addition the pages need and a reader does not: a
         FILE appender whose target a Gradle task names (narrativetrace.recipes.log), so one
         scenario's log lines land in one file a page can embed. Same pattern as the console one,
         clock and all — the embedded block is the real encoder's real output. -->
    <property name="LOG_FILE"
              value="${narrativetrace.recipes.log:-build/narrativetrace/recipes/suite.log}" />

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%-5level [%X{traceName}] [%logger] - %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.FileAppender">
        <file>${LOG_FILE}</file>
        <append>false</append>
        <encoder>
            <pattern>%-5level [%X{traceName}] [%logger] - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="narrativetrace" level="TRACE" />

    <root level="INFO">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="FILE" />
    </root>
</configuration>
