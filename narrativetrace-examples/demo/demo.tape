# charmbracelet VHS tape for the README demo recording.
# Regenerate with: ./gradlew :narrativetrace-examples:demoRecording (requires `vhs` installed).
Output narrativetrace-examples/demo/demo.gif

Set FontSize 15
Set Width 1200
Set Height 720
Set TypingSpeed 60ms

# --no-pause: a recording has nobody to press Enter, so the stop points would hang it.
Type "./demo.sh --example minecraft --no-pause"
Enter
Sleep 15s
