.gradle/
build/
!buildSrc/src/**
!buildSrc/*.kts
!*-build-tests/
!gradle/wrapper/gradle-wrapper.jar
!contract-probe/gradle/wrapper/gradle-wrapper.jar

*.class
*.jar
!gradle/wrapper/*.jar
!contract-probe/gradle/wrapper/*.jar

target/

.idea/
*.iml
.vscode/
.settings/
.classpath
.project
.gitsecret/keys/random_seed
!*.secret
secret.properties

.jqwik-database
# Jazzer writes its generated corpus here during `./gradlew fuzz`; only inputs
# that reproduce a finding are committed, by hand, into the seed corpus.
.cifuzz-corpus/
.next-run-progress.md
buildSrc/.kotlin/
# The same session directory for the main build. A session file lives here only while a build is
# running, so it is invisible to a `git status` taken between builds — and was missed until a gate
# looked DURING one.
/.kotlin/

# JVM fontconfig caches created when example runs see an unset HOME (dir literally named "?")
narrativetrace-examples/*/\?/
/\?/

# Machine-specific performance calibration results
/perf-calibration/

# Dogfooding sandbox (out-of-tree evaluation app, deliberately unversioned)
/dogfood/


# Gradle output directories anywhere — but never SOURCE dirs that happen to
# be named `build` (the ai.narrativetrace.build package lives under src/;
# the bare build/ pattern above silently swallowed a test file once).
!**/src/**/build/

# narrativetrace-soak run artifacts — never committed (see narrativetrace-soak/README.md)
narrativetrace-soak/logs/
narrativetrace-soak/results/
narrativetrace-soak/.soak.lock
