<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder><pattern>%-5level %logger{20} - %msg%n</pattern></encoder>
  </appender>
  <!-- The narration listener is part of the production assembly; its lines are not under test. -->
  <logger name="narrativetrace" level="OFF"/>
  <root level="WARN"><appender-ref ref="STDOUT"/></root>
</configuration>
